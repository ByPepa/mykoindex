# Zkopíruj do .env a vyplň. .env NIKDY necommituj (je v .gitignore).

# --- Netatmo OAuth2 (authorization_code) ---
# Aplikaci si založ na https://dev.netatmo.com → získáš client id/secret.
# refresh_token získáš jednorázově přes: python scripts/netatmo_auth.py
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=

# --- Copernicus CDS (ERA5-Land) ---
# Registrace na https://cds.climate.copernicus.eu, klíč z profilu.
# Formát: "<UID>:<APIKEY>" (nový CDS-Beta používá jen <APIKEY> jako token).
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
